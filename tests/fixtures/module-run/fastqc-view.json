        "versions_fastqc": {
            "tuple": true,
            "items": [
                {
                    "name": "${task.process}",
                    "type": "string",
                    "description": "The process the versions were collected from",
                    "pattern": null
                },
                {
                    "name": "fastqc",
                    "type": "string",
                    "description": "The tool name",
                    "pattern": null
                },
                {
                    "name": "fastqc --version | sed \"/FastQC v/!d; s/.*v//\"",
                    "type": "eval",
                    "description": "The expression to obtain the version of the tool",
                    "pattern": null
                }
            ]
        }
