// Added with -c on top of `-profile test,k8s` of tests/pipelines/synthetic/nextflow (the profile is not
// changed), for the kind clusters of dev/k8s/cluster.sh. Task pods must see the pipeline, its shared bin/
// and the work directory: kind mounts the repository into every node at its own path, and each task pod
// mounts it again as a hostPath at the same path (PodOptions.groovy L126-L127 at v26.10.4,
// https://github.com/nextflow-io/nextflow/blob/v26.10.4/plugins/nf-k8s/src/main/nextflow/k8s/model/PodOptions.groovy#L126-L127).
// Only valid where every node sees one disk (kind); a real cluster needs an RWX volume or Fusion (§4.2).
// -c files are applied after the profile, so the profile's run-id label is repeated here.

k8s {
    namespace = 'spectio-work'
    // K8S_CLEANUP=false keeps pods and Jobs after the run, so they can be dumped as fixtures.
    cleanup = (System.getenv('K8S_CLEANUP') ?: 'true').toBoolean()
    pod = [
        [label: 'spectio.io/run-id', value: System.getenv('SPECTIO_RUN_ID') ?: 'local'],
        [hostPath: System.getenv('K8S_MOUNT'), mountPath: System.getenv('K8S_MOUNT')],
    ] + (System.getenv('K8S_QUEUE') ? [[label: 'kueue.x-k8s.io/queue-name', value: System.getenv('K8S_QUEUE')]] : [])
}

executor {
    // the k8s executor polls every 5 s by default (K8sExecutor.groovy createTaskMonitor, v26.10.4)
    pollInterval = '2 sec'
}
