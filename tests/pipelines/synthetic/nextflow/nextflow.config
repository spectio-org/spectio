manifest {
    name            = 'spectio/synthetic-scenarios'
    description     = 'Synthetic three-stage pipeline with gate points and failure injection for Spectio tests'
    version         = '0.1.0'
    nextflowVersion = '!>=25.04.0'
    mainScript      = 'main.nf'
}

params.time_limit_s = 120   // per-attempt time limit; the timeout scenario lowers it

process {
    cpus   = 1
    memory = { 512.MB * task.attempt }
    time   = { "${(params.time_limit_s as int) * task.attempt}s" }
    // retry what a scheduler would retry: OOM (137), time limit (140 on Slurm, 143 local on 26.x), and the flaky injection.
    // Nextflow 25.10 kills a local task over its time limit without an exit code (exitStatus == Integer.MAX_VALUE).
    errorStrategy = { (task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] || params.fail_mode == 'flaky') && task.attempt < 3 ? 'retry' : 'terminate' }
    maxRetries    = 2
}

params.outdir = 'results'

// Task image of the docker and k8s profiles: python:3.12, index digest pinned 2026-10-27.
// Not -slim: Nextflow needs `ps` (procps) inside the container to collect task metrics.
// To update, copy the "Digest:" line of `docker buildx imagetools inspect python:3.12`.
params.python_image = 'python:3.12@sha256:98d8fe4e28bb2efeed9d9bce6a4705e80a6764367b65aea1dc4b96ded7b05620'

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,submit,start,complete,realtime,%cpu,peak_rss,workdir'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

profiles {
    test   {
        params.chunks = 2
    }
    local  {
        executor.name = 'local'
        executor.cpus = 2
    }
    docker {
        docker.enabled    = true
        // nextflow/bin/synth.py links to ../../bin: mount that directory too, or the link is dangling.
        // Tasks run as the invoking user, not root; the path is single-quoted for the shell of .command.run.
        docker.runOptions = "-u \$(id -u):\$(id -g) -v '${projectDir.parent}/bin:${projectDir.parent}/bin:ro'"
        process.container = params.python_image
    }
    slurm  {
        executor.name = 'slurm'
        executor.queueStatInterval = '15 sec'
        process {
            queue = 'htc'
            withName: 'ALIGN' { array = 20 }   // job arrays on grid executors
        }
    }
    k8s {
        executor.name = 'k8s'
        process.container = params.python_image
        k8s.pod = [[label: 'spectio.io/run-id', value: System.getenv('SPECTIO_RUN_ID') ?: 'local']]
    }
    stress {   // ~12 000 ALIGN tasks
        params.chunks = 100
        params.scale  = 10
    }
}
