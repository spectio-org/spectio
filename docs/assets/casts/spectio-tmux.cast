[18.86, "o", "1. On your laptop, open a tunnel:  ssh -N -L 127.0.0.1:18083:127.0.0.1:18083 alice@demo-hpc-login1\r\n"]
[18.9, "o", "2. Then open this link (single use, valid 15 minutes):\r\n"]
[18.94, "o", "   http://127.0.0.1:18083/auth/link#<ticket>\r\n"]
[18.98, "o", "Each run's head runs in a tmux session on demo-hpc-login1: tmux attach -t spectio-<run ID>.\r\n"]
[19.02, "o", "The API is served in local mode only until sign-in is complete (P1 Tasks 13 to 16).\r\n"]
[19.06, "o", "New link at any time: spectio login --print-link\r\n"]
[19.1, "o", "Spectio never asks you to paste a link.\r\n"]
[19.9, "o", "\u001b[32m$ \u001b[0m"]
[22.9, "o", ""]
[23.9, "o", ""]
