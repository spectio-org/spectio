{
  "name": "Spectio (dev)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000, 8080],
  "portsAttributes": {
    "8000": { "label": "Docs (mkdocs serve)", "onAutoForward": "openPreview" },
    "8080": { "label": "Spectio (demo mode, once it exists)", "onAutoForward": "notify" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["docs/map.md"] },
    "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff", "redhat.vscode-yaml"] }
  }
}
