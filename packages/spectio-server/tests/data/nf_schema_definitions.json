{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://example.org/synthetic/nextflow_schema.json",
  "title": "synthetic pipeline parameters (nf-core shape, draft 7)",
  "type": "object",
  "definitions": {
    "input_output_options": {
      "title": "Input/output",
      "type": "object",
      "required": ["outdir"],
      "properties": {
        "input": {"type": "string", "format": "file-path", "description": "Samplesheet"},
        "outdir": {"type": "string", "default": "results"}
      }
    },
    "options": {
      "title": "Options",
      "type": "object",
      "properties": {
        "chunks": {"type": "integer", "default": 0, "minimum": 0},
        "fail_mode": {"type": "string", "enum": ["none", "exit", "flaky"], "default": "none"},
        "seed": {"type": "integer", "default": 42, "hidden": true}
      }
    }
  },
  "allOf": [
    {"$ref": "#/definitions/input_output_options"},
    {"$ref": "#/definitions/options"}
  ]
}
