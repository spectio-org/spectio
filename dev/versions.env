# Spectio development toolchain: every pin in one place.
# Owner: docs/specs/dev-environment-and-testing.md §1. Read by dev/bootstrap.sh, dev/doctor.sh
# and .devcontainer/setup.sh. Plain KEY=value lines, so that shell `.` and a Renovate regex
# manager can both read them. Checksums are for linux/amd64, the only platform bootstrap supports.
# Each pin cites where it was read on 2026-10-27; "upstream sha" means the published checksum
# file matched the download, "computed" means no checksum is published and the value is the
# sha256 of the download on that date.

# --- Prerequisites: checked by doctor, installed by the platform, not by bootstrap ----------
# Docker Engine >= 28 on cgroup v2 is what sind needs (sind README.md:40 at v0.15.0).
DOCKER_MIN_MAJOR=28
# Java 21 for Nextflow (§1: Temurin, distro package or SDKMAN); doctor checks the major only.
JAVA_MAJOR=21

# --- Python ----------------------------------------------------------------------------------
# uv: the version pre-installed in Claude Code cloud sessions (spike D2), so the cloud setup
# reuses it. https://github.com/astral-sh/uv/releases/tag/0.11.32 (upstream sha).
UV_VERSION=0.11.32
UV_SHA256=aab924fd522efd06f1c5f3b93a243864fc453132c94b2dc49f1371b528a4b967
# uv-managed CPython (python-build-standalone). §1 wants SQLite >= 3.51.3 in it; doctor checks.
# Newest 3.13 patch that `uv python list 3.13` offers with uv 0.11.32.
PYTHON_VERSION=3.13.14
SQLITE_MIN_VERSION=3.51.3

# --- Node ------------------------------------------------------------------------------------
# Node 24 LTS (§1). https://nodejs.org/dist/v24.22.1/SHASUMS256.txt (upstream sha, linux-x64).
NODE_VERSION=24.22.1
NODE_SHA256=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6
# Playwright: the version whose Chromium is pre-installed under /opt/pw-browsers in cloud
# sessions (spike D2); any other version downloads a browser from a host off the allowlist.
# https://www.npmjs.com/package/playwright/v/1.63.0. Also in dev/npm/package.json, whose
# package-lock.json carries the integrity hashes; doctor fails if the two disagree.
PLAYWRIGHT_VERSION=1.63.0

# --- Workflow engines ------------------------------------------------------------------------
# Nextflow: the default plus the tested range of §1 (26.10.x, 25.10.x, 25.04.x floor). The
# `-dist` asset of each tag, https://github.com/nextflow-io/nextflow/releases (computed sha:
# no checksum file is published).
NEXTFLOW_VERSION=26.10.4
NEXTFLOW_SHA256=2cbda6e7fdbbb1e7a413973eff549653f566ba6bb7bdfbb58eb78d0f831fdec4
NEXTFLOW_25_10_VERSION=25.10.9
NEXTFLOW_25_10_SHA256=8f3e6efe3b700c298aedf45ba2d5ec0d17bd5f480362b1b46145ea6bfbe46987
NEXTFLOW_25_04_VERSION=25.04.8
NEXTFLOW_25_04_SHA256=df18b2c5d89b47f471c71379a8f830a79973c1ba6ff56a55289483764d5e02ac
# Snakemake: the latest of §1. The minimum tested version is set by R9 spike 2 [to be validated].
# https://pypi.org/project/snakemake/9.27.1/ and the plugin pages on PyPI. Every dependency is
# hash-locked in dev/snakemake.lock.txt; after changing one of these three pins, regenerate it:
#   printf '%s\n' snakemake==A snakemake-executor-plugin-slurm==B snakemake-executor-plugin-kubernetes==C |
#   uv pip compile - --generate-hashes --python-version 3.13 --python-platform x86_64-manylinux_2_28 \
#     --custom-compile-command 'see the SNAKEMAKE_* pins in dev/versions.env' -o dev/snakemake.lock.txt
SNAKEMAKE_VERSION=9.27.1
SNAKEMAKE_EXECUTOR_SLURM_VERSION=2.8.0
SNAKEMAKE_EXECUTOR_KUBERNETES_VERSION=0.5.1

# --- Local clusters --------------------------------------------------------------------------
# sind: https://github.com/GSI-HPC/sind/releases/tag/v0.15.0 (upstream sha, checksums.txt).
# Node image: the one the release binary defaults to (sind .goreleaser.yaml ldflags), by digest.
# CoreDNS: the mesh's DNS image (sind pkg/mesh/mesh.go:59 at v0.15.0), from Docker Hub.
SIND_VERSION=0.15.0
SIND_SHA256=8158bfb87f5759d59855b0baf9ea6848bd3fcb7182c276b1aa48688688d5c572
SIND_NODE_IMAGE=ghcr.io/gsi-hpc/sind-node:v0.15.0@sha256:b6d7b4b4440be8f8c9b020d6bee4bf93832becc4407315823793e0b136c02af2
SIND_DNS_IMAGE=coredns/coredns:1.15.0@sha256:0a9d8c8ddf34347eb59aad9a8784f0710de88d6d112726d11d271f9bc6daca26
# kind: https://github.com/kubernetes-sigs/kind/releases/tag/v0.33.0 (upstream sha); the node
# image and digest are the release's default, from its release notes.
KIND_VERSION=0.33.0
KIND_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
# kubectl: https://dl.k8s.io/release/stable.txt said v1.37.1 (upstream sha, kubectl.sha256).
KUBECTL_VERSION=1.37.1
KUBECTL_SHA256=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
# helm: https://github.com/helm/helm/releases/tag/v4.3.1, marked Latest (upstream sha, get.helm.sh).
HELM_VERSION=4.3.1
HELM_SHA256=0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b
# Kueue manifests for k8s-kueue (§1, §4.2): the newest minor and the previous one, applied by
# scenarios, not by bootstrap. https://github.com/kubernetes-sigs/kueue/releases (v0.20.3 and
# v0.19.10, both 2026-10-22). Whether v0.19 supports Kubernetes 1.33 is [to be validated].
KUEUE_VERSION=0.20.3
KUEUE_PREVIOUS_VERSION=0.19.10
# sha256 of the v0.20.3 release's manifests.yaml (computed: no checksum file is published), read by
# dev/k8s/cluster.sh. https://github.com/kubernetes-sigs/kueue/releases/download/v0.20.3/manifests.yaml
KUEUE_MANIFEST_SHA256=646840e4c4bcefd92ddcfcb233a55fe73416a0038ce9eb8d42322b2ef5fd1d54
# Nextflow 25.10 does not start its k8s executor unless the plugin is named ("Unknown executor name:
# k8s"); 1.2.3 is the nf-k8s version 25.10.9's own log lists among its core plugins (spike t4-ci,
# docs/research/spike-t4-ci-2026-10-28.md). 26.10 bundles the executor.
NF_K8S_25_10_VERSION=1.2.3

# --- Smoke-test images (dev/doctor.sh), by digest ---------------------------------------------
HELLO_WORLD_IMAGE=hello-world:latest@sha256:11a3eb1597e864c51b3f56733cb2e8a90bf0c284bfc05f9444d81c558bc848aa
BUSYBOX_IMAGE=busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e

# --- Pulled on demand, never by bootstrap --------------------------------------------------
# Docs CI (§1): `npx -y @mermaid-js/mermaid-cli@$MERMAID_CLI_VERSION`,
# `uvx --with mkdocs-material==$MKDOCS_MATERIAL_VERSION mkdocs==$MKDOCS_VERSION`. Versions from npm
# and PyPI on 2026-10-27; 11.17.0 is the mermaid-cli the D2 spike ran (12.0.0 is the latest).
MERMAID_CLI_VERSION=11.17.0
MKDOCS_VERSION=1.6.1
MKDOCS_MATERIAL_VERSION=9.8.0
# depictio for tier 5 hand-off tests (§1, decided by Thomas, 2026-10-27, inbox #22).
DEPICTIO_VERSION=v1.19.2
