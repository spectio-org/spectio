// Added with -c on top of `-profile test,k8s` of tests/pipelines/synthetic/nextflow (the profile is
// not changed). It solves the open item of the T1 note (finding 3, open item 6): task pods must see
// the shared tests/pipelines/synthetic/bin/ that nextflow/bin/synth.py links to.
//
// How: the head runs on the CI runner, outside the cluster. kind mounts the runner's work tree
// (SPIKE_MOUNT, e.g. /home/runner/work) into every node at the same path (kind extraMounts), and each
// task pod mounts it again as a hostPath at the same path. The launch directory, the work directory and
// the pipeline (with its bin/ link target) all live under it, so every path the head writes into
// .command.run resolves inside the pod. Only valid on a single machine (kind), never on a real cluster.
//
// k8s.pod hostPath/mountPath: plugins/nf-k8s/src/main/nextflow/k8s/model/PodOptions.groovy L126-L127
// at v26.10.4. -c files are applied after the profile, so the profile's run-id label is repeated here.

k8s {
    namespace = 'spectio-work'
    // Keep pods and Jobs after the run so they can be dumped as fixtures (default: delete on success).
    cleanup = (System.getenv('SPIKE_CLEANUP') ?: 'false').toBoolean()
    pod = [
        [label: 'spectio.io/run-id', value: System.getenv('SPECTIO_RUN_ID') ?: 'local'],
        [hostPath: System.getenv('SPIKE_MOUNT') ?: '/home/runner/work', mountPath: System.getenv('SPIKE_MOUNT') ?: '/home/runner/work'],
    ] + (System.getenv('SPIKE_QUEUE') ? [[label: 'kueue.x-k8s.io/queue-name', value: System.getenv('SPIKE_QUEUE')]] : [])
}

executor {
    // the k8s executor polls every 5 s by default (K8sExecutor.groovy createTaskMonitor, v26.10.4)
    pollInterval = '2 sec'
}
